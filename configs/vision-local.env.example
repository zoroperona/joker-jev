# Self-hosted System One service. Never points to a developer's private server.
TYPESAFE_API_URL=http://127.0.0.1:8000/v1/systemone
# Official autojev server accepts this compatibility alias.
# Inspect the response model to identify the actual loaded checkpoint.
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_AUTH=none
TYPESAFE_ALLOW_HTTP=1
TYPESAFE_API_KEY=
